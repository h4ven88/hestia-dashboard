<?xml version="1.0" encoding="utf-8"?>
<!--
  No density-specific PNG fallbacks, and that is correct rather than missing:
  minSdk is 26 and this qualifier covers API 26 and up, so every device that
  can install the app reads this file.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/hestia_icon_bg" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
